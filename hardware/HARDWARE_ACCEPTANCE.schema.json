{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/naqya/hardware-acceptance.schema.json",
  "title": "NAQYA Hardware Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_fingerprint",
    "test_profile",
    "platform",
    "device",
    "package",
    "model",
    "audio",
    "measurements",
    "diagnostics",
    "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_profile": {"enum": ["smoke", "long30", "long60"]},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture"],
      "properties": {
        "os": {"enum": ["linux", "windows"]},
        "os_version": {"type": "string", "minLength": 1},
        "architecture": {"const": "x86_64"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "ram_mb", "microphone"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "ram_mb": {"type": "integer", "minimum": 512},
        "microphone": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "installed", "application_started", "bundled_sidecar_used"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "installed": {"type": "boolean"},
        "application_started": {"type": "boolean"},
        "bundled_sidecar_used": {"type": "boolean"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "protected_path_used"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protected_path_used": {"type": "boolean"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["microphone_capture_ok", "live_dictation_ok", "temp_wav_cleanup_ok", "provider"],
      "properties": {
        "microphone_capture_ok": {"type": "boolean"},
        "live_dictation_ok": {"type": "boolean"},
        "temp_wav_cleanup_ok": {"type": "boolean"},
        "provider": {"const": "whisper.cpp-sidecar"}
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "segments_total", "segments_lost", "realtime_factor_avg", "realtime_factor_max", "peak_ram_mb"],
      "properties": {
        "duration_seconds": {"type": "integer", "minimum": 1},
        "segments_total": {"type": "integer", "minimum": 1},
        "segments_lost": {"type": "integer", "minimum": 0},
        "realtime_factor_avg": {"type": "number", "exclusiveMinimum": 0},
        "realtime_factor_max": {"type": "number", "exclusiveMinimum": 0},
        "peak_ram_mb": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_sha256", "observed_error_codes"],
      "properties": {
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_error_codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^NAQYA-[A-Z]+-[0-9]{4}$"},
          "uniqueItems": true
        }
      }
    },
    "result": {"enum": ["PASS", "FAIL"]}
  }
}
