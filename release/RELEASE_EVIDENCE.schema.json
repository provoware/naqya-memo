{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/naqya/release-evidence.schema.json",
  "title": "NAQYA Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "source",
    "target",
    "frontend",
    "whisper",
    "desktop_package",
    "runtime_dependencies",
    "diagnostics_contract",
    "toolchain",
    "ci",
    "validations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "bundle-validated"},
    "generated_at": {"type": "string"},
    "source": {"type": "object"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "rust_target"],
      "properties": {
        "os": {"enum": ["linux", "windows"]},
        "architecture": {"const": "x86_64"},
        "rust_target": {"enum": ["x86_64-unknown-linux-gnu", "x86_64-pc-windows-msvc"]}
      }
    },
    "frontend": {"type": "object"},
    "whisper": {"type": "object"},
    "desktop_package": {
      "type": "object",
      "required": ["file", "format", "bytes", "sha256", "reproducibility_profile", "source_date_epoch"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "format": {"enum": ["deb", "nsis"]},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reproducibility_profile": {"enum": ["dpkg-deb-normalized-v1", "tauri-nsis-pinned-v1"]},
        "source_date_epoch": {"const": 946684800}
      }
    },
    "runtime_dependencies": {"type": "object"},
    "diagnostics_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "schema_version", "event_schema_version", "format", "sha256"],
      "properties": {
        "file": {"const": "diagnostics/DIAGNOSTICS_CONTRACT.json"},
        "schema_version": {"const": 1},
        "event_schema_version": {"const": 1},
        "format": {"const": "NAQYA-DIAGNOSTICS"},
        "sha256": {"const": "fa160ea4cb259406ecd057ebfb225d862b4484f10dba4e83948755c6fda65425"}
      }
    },
    "toolchain": {"type": "object"},
    "ci": {"type": "object"},
    "validations": {
      "type": "object",
      "required": [
        "frontend_manifest_verified",
        "source_sidecar_sha_matches_packaged",
        "packaged_sidecar_started",
        "runtime_dependencies_resolved",
        "package_reproducibility_verified",
        "diagnostics_contract_bound"
      ],
      "properties": {
        "frontend_manifest_verified": {"const": true},
        "source_sidecar_sha_matches_packaged": {"const": true},
        "packaged_sidecar_started": {"const": true},
        "runtime_dependencies_resolved": {"const": true},
        "package_reproducibility_verified": {"const": true},
        "package_repack_deterministic": {"type": "boolean"},
        "diagnostics_contract_bound": {"const": true}
      }
    }
  }
}
