{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVOWARE – NAQYA Memo Tool 2026",
  "version": "0.3.0",
  "identifier": "de.provoware.naqya.memo",
  "build": {
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NAQYA Memo Tool 2026",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: blob: data:; media-src 'self' asset: blob: data:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi"],
    "resources": ["../runtime/models"]
  }
}
