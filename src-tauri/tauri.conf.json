{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAQYA Memo Tool 2026",
  "version": "0.4.0",
  "identifier": "de.provoware.naqya.memo",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "title": "PROVOWARE – NAQYA Memo Tool 2026",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/naqya-whisper"
    ]
  }
}
