{
  "schema_version": 1,
  "event_schema_version": 1,
  "format": "NAQYA-DIAGNOSTICS",
  "max_events": 200,
  "dedupe_window_ms": 5000,
  "code_pattern": "^NAQYA-(APP|DATA|AUDIO|STT|MODEL|RUNTIME|BUNDLE|RELEASE)-[0-9]{4}$",
  "privacy": {
    "persist_sanitized_only": true,
    "full_paths_allowed": false,
    "audio_content_allowed": false,
    "transcript_content_allowed": false,
    "document_content_allowed": false,
    "max_string_length": 240,
    "forbidden_keys": [
      "audio",
      "audioBase64",
      "base64",
      "blob",
      "content",
      "document",
      "entryText",
      "password",
      "secret",
      "text",
      "token",
      "transcript"
    ]
  },
  "safe_actions": {
    "close": {"label": "Schließen", "max_attempts": 0},
    "settings": {"label": "Einstellungen öffnen", "max_attempts": 0},
    "export-json": {"label": "Diagnose als JSON speichern", "max_attempts": 0},
    "export-text": {"label": "Diagnose lesbar speichern", "max_attempts": 0},
    "retry-once": {"label": "Einmal erneut versuchen", "max_attempts": 1}
  },
  "codes": {
    "NAQYA-APP-1002": {"severity": "error", "category": "app", "what": "Unerwarteter Programmfehler", "options": ["export-json", "export-text", "close"]},
    "NAQYA-APP-1003": {"severity": "error", "category": "app", "what": "Unbehandelter asynchroner Programmfehler", "options": ["export-json", "export-text", "close"]},
    "NAQYA-APP-1101": {"severity": "info", "category": "app", "what": "Sichere Diagnoseaktion gewählt", "options": []},
    "NAQYA-APP-1102": {"severity": "error", "category": "app", "what": "Einmaliger Wiederholungsversuch fehlgeschlagen", "options": ["export-json", "export-text", "close"]},
    "NAQYA-AUDIO-3001": {"severity": "error", "category": "audio", "what": "Audioaufnahme konnte nicht zuverlässig fortgesetzt werden", "options": ["settings", "export-json", "close"]},
    "NAQYA-STT-4001": {"severity": "warning", "category": "stt", "what": "Lokaler STT-Provider ist nicht verfügbar", "options": ["settings", "export-json", "close"]},
    "NAQYA-STT-4002": {"severity": "error", "category": "stt", "what": "Live-STT-Segment konnte nicht transkribiert werden", "options": ["settings", "export-json", "export-text", "close"]},
    "NAQYA-STT-4003": {"severity": "error", "category": "stt", "what": "PCM-Audioerfassung für Live-STT ist fehlgeschlagen", "options": ["settings", "export-json", "close"]},
    "NAQYA-STT-4004": {"severity": "error", "category": "stt", "what": "Native Offline-Live-STT konnte nicht gestartet werden", "options": ["settings", "export-json", "export-text", "close"]},
    "NAQYA-STT-4005": {"severity": "error", "category": "stt", "what": "Offline-Diktat konnte nicht sauber abgeschlossen werden", "options": ["export-json", "export-text", "close"]},
    "NAQYA-MODEL-5001": {"severity": "error", "category": "model", "what": "Lokales Sprachmodell konnte nicht materialisiert werden", "options": ["settings", "export-json", "export-text", "close"]},
    "NAQYA-RUNTIME-6001": {"severity": "error", "category": "runtime", "what": "Native Desktop-Brücke ist für diese Aktion nicht verfügbar", "options": ["settings", "export-json", "close"]},
    "NAQYA-RUNTIME-6002": {"severity": "error", "category": "runtime", "what": "Native Laufzeitfähigkeiten konnten nicht gelesen werden", "options": ["export-json", "export-text", "close"]},
    "NAQYA-RUNTIME-6003": {"severity": "error", "category": "runtime", "what": "Native Transkription ist fehlgeschlagen", "options": ["settings", "export-json", "export-text", "close"]},
    "NAQYA-RELEASE-8001": {"severity": "info", "category": "release", "what": "Release-/Diagnosevertrag gebunden", "options": []}
  }
}
